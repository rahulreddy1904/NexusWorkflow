# ==============================================================================
# NEXUS WORKFLOW — FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' in the frontend/ folder:
#   cp .env.example .env
#
# FOR GITHUB & CLOUD DEPLOYMENT (Running in a normal browser, not localhost):
# When you deploy your frontend to Vercel, Netlify, Render, or Cloudflare Pages,
# set VITE_API_URL in the host's Environment Variables dashboard to your
# deployed backend URL (e.g. https://nexus-api.onrender.com).
# ==============================================================================

# Backend API Base URL
# - Local development: http://localhost:5000 (or leave blank for local Vite proxy)
# - Remote/Production: https://your-backend-api.onrender.com
VITE_API_URL=http://localhost:5000

# Application Branding
VITE_APP_NAME="NEXUS Workflow — Autonomous Multi-Agent Orchestration"

# Environment Mode (development | production)
VITE_APP_ENV=development
