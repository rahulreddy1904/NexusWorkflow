# ==========================================
# NEXUS WORKFLOW BACKEND CONFIGURATION
# ==========================================

# Server Settings
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (Supabase PostgreSQL)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# If left empty, backend boots with local in-memory PostgreSQL emulator for zero-friction local development & testing.
DATABASE_URL=
DATABASE_SSL=true

# Authentication Secrets
# Generate a strong 32+ character random string for production
JWT_SECRET=nexus_super_secret_jwt_key_min_32_characters_dev_2026
JWT_EXPIRES_IN=7d
COOKIE_SECRET=nexus_cookie_secret_dev_key_2026

# Google Gemini AI Service
# Obtain key from: https://aistudio.google.com/app/apikey
# Model default: gemini-3.8-flash (fast, balanced multi-agent orchestration)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=3

# Google OAuth 2.0 (Optional - for Sign in with Google)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:5000/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/google/callback

# Facebook OAuth (Optional - for Sign in with Facebook)
# Create credentials at: https://developers.facebook.com/apps/
# Valid OAuth Redirect URI: http://localhost:5000/api/v1/auth/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/facebook/callback

# Workflow Execution Engine Limits
WORKFLOW_MAX_STEPS=12
WORKFLOW_STEP_TIMEOUT_MS=60000
WORKFLOW_MAX_RETRIES=3
WORKFLOW_WORKER_INTERVAL_MS=2000
